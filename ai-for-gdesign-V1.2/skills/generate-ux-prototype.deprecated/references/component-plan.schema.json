{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "assetId", "assetVersion", "directionId", "templateId", "components", "interactions"],
  "properties": {
    "schemaVersion": { "const": "2.2" },
    "assetId": { "type": "string", "minLength": 1 },
    "assetVersion": { "type": "string", "minLength": 1 },
    "directionId": { "type": "string", "minLength": 1 },
    "templateId": { "type": "string", "minLength": 1 },
    "components": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "interactions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "assetGaps": { "type": "array", "items": { "type": "string" }, "default": [] }
  },
  "additionalProperties": false
}
