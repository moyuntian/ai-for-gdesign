{
  "name": "@g-design/enterprise",
  "version": "1.3.0",
  "description": "G Design enterprise UI assets based on Element Plus 2.13.5",
  "type": "module",
  "main": "dist/g-design-enterprise.js",
  "module": "dist/g-design-enterprise.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "src", "tokens", "assets", "licenses", "references", "asset-manifest.json", "README.md", "CHANGELOG.md"],
  "exports": {
    ".": {
      "import": "./dist/g-design-enterprise.js",
      "require": "./dist/g-design-enterprise.umd.cjs"
    },
    "./style.css": "./dist/g-design-enterprise.css",
    "./tokens": "./tokens/index.scss",
    "./manifest": "./asset-manifest.json"
    ,"./icons/*": "./assets/icons/lucide/icons/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "validate": "node scripts/validate-assets.mjs && node scripts/validate-tokens.mjs && node scripts/validate-icons.mjs"
  },
  "peerDependencies": {
    "vue": ">=3.4.0"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "element-plus": "2.13.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "5.2.4",
    "sass": "1.89.2",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vue": "3.5.16",
    "vue-tsc": "2.2.10"
  }
}
